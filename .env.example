# Scout settings. EVERYTHING here is optional: Scout runs with no settings at all.
# Put real values in your hosting dashboard (Environment / Secrets), never in Git.

# --- Web server ---
# PORT=3000                     # Hosting platforms set this for you (Docker image uses 7860)
# PUBLIC_URL=https://scout.example.com   # Usually detected automatically (Render, Hugging Face, Railway, Fly, Codespaces)
# DATA_DIR=./data               # Where the SQLite database and model files live (Docker: /data)

# --- Scout's own app key (the key LoginLens uses to call Scout) ---
# Leave empty: Scout creates one on first start and shows it once at PUBLIC_URL/setup.
# SCOUT_APP_KEY=                # Optional: provide your own sct_sec_... key as a hosting secret instead
# SCOUT_NEW_APP_KEY=false       # Set to true and restart to get a brand-new key (then set it back)
# SETUP_WINDOW_MINUTES=60       # How long the setup page shows the new key

# --- Security ---
# SCOUT_ENCRYPTION_KEY=         # Optional long random text (32+ characters). Without it Scout makes one in DATA_DIR.
#                               # Set it if your database is Postgres or your disk can reset.
# SCOUT_ALLOWED_ORIGINS=        # Extra websites allowed to show the chat window, comma separated
#                               # (LoginLens can also set this itself through PUT /v1/settings)

# --- The AI (free and local by default; no AI key needed) ---
# MODEL_PROVIDER=ollama         # ollama (free, local) | anthropic | gemini | groq | openrouter | openai-compatible | mock
# MODEL_NAME=hf.co/unsloth/Qwen3.5-4B-GGUF:Q4_K_M   # Default local model (tested). Alternative: qwen3.5:4b, or qwen3.5:2b for 4 GB servers
# OLLAMA_AUTOSTART=true         # Scout starts the Ollama runtime itself
# OLLAMA_AUTO_PULL=true         # Scout downloads the model on first start if it is missing
# OLLAMA_CONTEXT_LENGTH=8192
# OLLAMA_NO_CLOUD=1             # Keep Ollama fully local (no calls to ollama.com)
# MODEL_REASONING_EFFORT=none   # 'none' turns off slow "thinking" on a CPU

# Only if you ever switch to a paid cloud AI (NOT needed for the free local model):
# SCOUT_MODEL_API_KEY=          # The cloud provider's key, as a hosting secret
# MODEL_BASE_URL=               # For openai-compatible providers
# FALLBACK_PROVIDER= / FALLBACK_MODEL_NAME= / SCOUT_FALLBACK_API_KEY=   # Optional backup AI

# --- Limits (protect your server from abuse) ---
# USER_MESSAGES_PER_MINUTE=6
# USER_MESSAGES_PER_DAY=200
# USER_MONTHLY_TOKENS=2000000
# APP_KEY_REQUESTS_PER_MINUTE=120
# IP_REQUESTS_PER_MINUTE=30
# MAX_CONCURRENT_CHATS=1        # Answers generated at the same time (1 is best on a small CPU)
# MAX_QUEUED_CHATS=8            # How many can wait in line
# MAX_MESSAGE_CHARS=2000

# --- Demo page with made-up sample data (/demo) ---
# DEMO_MODE=false               # The demo is open for the first setup hour anyway; true keeps it open
# DEMO_DAILY_MESSAGES=300

# --- Database ---
# DATABASE_URL=                 # Empty = SQLite file in DATA_DIR. Or postgres://user:pass@host:5432/db
# DATABASE_SSL_NO_VERIFY=false

# --- LoginLens connection (development only) ---
# CONNECTOR_ALLOW_PRIVATE_NETWORK=false   # true only if LoginLens runs on the same private network (e.g. docker compose)
